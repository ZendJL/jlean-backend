generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        Profile?
  userGoals      UserGoal[]
  dayTypes       DayType[]
  assignedDays   DayAssignment[]
  recipes        Recipe[]
  foodLogs       FoodLog[]
  refreshTokens  RefreshToken[]
  supplements    Supplement[]
  supplementLogs SupplementLog[]
  sleepEntries   SleepEntry[]
  fastingConfig  FastingConfig?
  weightLogs     WeightLog[]
  mealPlans      MealPlan[]
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("refresh_tokens")
}

// ─── Profile ──────────────────────────────────────────────────────────────────

model Profile {
  id            String        @id @default(uuid())
  userId        String        @unique
  birthDate     DateTime?
  gender        Gender?
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel @default(SEDENTARY)
  goal          Goal          @default(MAINTAIN)
  calorieTarget Int?
  proteinTarget Float?
  carbTarget    Float?
  fatTarget     Float?
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

// ─── Goal History ─────────────────────────────────────────────────────────────

model UserGoal {
  id            String        @id @default(uuid())
  userId        String
  calorieTarget Int
  proteinTarget Float
  carbTarget    Float
  fatTarget     Float
  goal          Goal
  activityLevel ActivityLevel
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, effectiveFrom])
  @@map("user_goals")
}

// ─── Day Types ────────────────────────────────────────────────────────────────

model DayType {
  id           String          @id @default(uuid())
  userId       String
  name         String
  tdeAdjustPct Float           @default(0)
  color        String?
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  DayAssignment[]
  @@unique([userId, name])
  @@map("day_types")
}

model DayAssignment {
  id        String   @id @default(uuid())
  userId    String
  dayTypeId String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayType   DayType  @relation(fields: [dayTypeId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([userId, date])
  @@map("day_assignments")
}

// ─── Foods ────────────────────────────────────────────────────────────────────

model Food {
  id            String        @id @default(uuid())
  name          String
  brand         String?
  source        FoodSource    @default(CUSTOM)
  externalId    String?
  barcode       String?
  servingSizeG  Float         @default(100)
  servingUnit   String        @default("g")
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  fiber         Float?
  sugar         Float?
  sodium        Float?
  saturatedFat  Float?
  caffeineMg    Float?
  alcoholG      Float?
  qualityStatus DataQuality   @default(COMPLETE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  recipeItems   RecipeItem[]
  foodLogItems  FoodLogItem[]
  mealPlanItems MealPlanItem[]
  @@unique([source, externalId])
  @@index([name])
  @@index([barcode])
  @@map("foods")
}

enum FoodSource {
  CUSTOM
  PRESET
  USDA
  OFF
}

enum DataQuality {
  COMPLETE
  PARTIAL
  UNVERIFIED
  CONFLICTED
}

// ─── Recipes ──────────────────────────────────────────────────────────────────

model Recipe {
  id            String         @id @default(uuid())
  userId        String
  name          String
  description   String?
  servings      Int            @default(1)
  isPublic      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         RecipeItem[]
  foodLogItems  FoodLogItem[]
  mealPlanItems MealPlanItem[]
  @@map("recipes")
}

model RecipeItem {
  id       String @id @default(uuid())
  recipeId String
  foodId   String
  quantityG Float
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food     Food   @relation(fields: [foodId], references: [id])
  @@map("recipe_items")
}

// ─── Daily Log ────────────────────────────────────────────────────────────────

model FoodLog {
  id        String        @id @default(uuid())
  userId    String
  date      DateTime      @db.Date
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     FoodLogItem[]
  @@unique([userId, date])
  @@index([userId, date])
  @@map("food_logs")
}

model FoodLogItem {
  id               String   @id @default(uuid())
  logId            String
  foodId           String?
  recipeId         String?
  meal             Meal     @default(OTHER)
  quantityG        Float
  snapshotName     String?
  snapshotCalories Float?
  snapshotProtein  Float?
  snapshotCarbs    Float?
  snapshotFat      Float?
  createdAt        DateTime @default(now())
  log              FoodLog  @relation(fields: [logId], references: [id], onDelete: Cascade)
  food             Food?    @relation(fields: [foodId], references: [id])
  recipe           Recipe?  @relation(fields: [recipeId], references: [id])
  @@map("food_log_items")
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

// ─── Supplements ─────────────────────────────────────────────────────────────

model Supplement {
  id                String          @id @default(uuid())
  userId            String
  name              String
  doseAmount        Float
  doseUnit          String
  frequency         String?
  timing            String?
  notes             String?
  caffeinePerDoseMg Float?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs              SupplementLog[]
  @@map("supplements")
}

model SupplementLog {
  id           String     @id @default(uuid())
  userId       String
  supplementId String
  takenAt      DateTime   @default(now())
  notes        String?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  @@map("supplement_logs")
}

// ─── Sleep ────────────────────────────────────────────────────────────────────

model SleepEntry {
  id           String   @id @default(uuid())
  userId       String
  bedtime      DateTime
  wakeTime     DateTime
  durationMin  Int
  qualityScore Float?
  deepSleepMin Int?
  remSleepMin  Int?
  awakensCount Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sleep_entries")
}

// ─── Fasting ─────────────────────────────────────────────────────────────────

model FastingConfig {
  id           String   @id @default(uuid())
  userId       String   @unique
  fastHours    Int
  eatHours     Int
  eatStartHour Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("fasting_configs")
}

// ─── Weight History (v2) ──────────────────────────────────────────────────────
// Registro temporal del peso corporal del usuario.

model WeightLog {
  id          String   @id @default(uuid())
  userId      String
  weightKg    Float
  note        String?
  recordedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, recordedAt])
  @@map("weight_logs")
}

// ─── Meal Planning (v2) ───────────────────────────────────────────────────────
// Plan semanal de comidas. Cada plan cubre una semana (weekStart = lunes).

model MealPlan {
  id        String         @id @default(uuid())
  userId    String
  name      String
  weekStart DateTime       @db.Date
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MealPlanItem[]
  @@index([userId, weekStart])
  @@map("meal_plans")
}

model MealPlanItem {
  id         String   @id @default(uuid())
  planId     String
  date       DateTime @db.Date
  meal       Meal     @default(OTHER)
  foodId     String?
  recipeId   String?
  quantityG  Float    @default(100)
  createdAt  DateTime @default(now())
  plan       MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  food       Food?    @relation(fields: [foodId], references: [id])
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
  @@index([planId, date])
  @@map("meal_plan_items")
}
